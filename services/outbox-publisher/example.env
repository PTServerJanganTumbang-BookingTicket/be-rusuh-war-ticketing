APP_PORT=8083
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=json

DATABASE_URL=postgres://rusuh:rusuh@localhost:5432/rusuh?sslmode=disable
DATABASE_MAX_CONNS=4
DATABASE_CONN_LIFETIME=30m

REDIS_ADDR=localhost:6379
REDIS_DB=0

# Required: there is nowhere to publish without it.
NOTIFICATION_QUEUE_URL=

# ADR-005 §9 step 4: one pass per second, 500 rows per pass.
PUBLISH_INTERVAL_MS=1000
PUBLISH_BATCH_SIZE=500

# Lambda mode only: how long one invocation keeps draining, since EventBridge
# cannot schedule faster than once a minute.
DRAIN_BUDGET_SECONDS=45

# ADR-005 §9 step 3. Must not be shorter than the pass interval, or a second
# worker can claim a row the first is still publishing.
OUTBOX_LEASE_SECONDS=30
OUTBOX_LEASE_DONE_SECONDS=86400
