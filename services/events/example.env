APP_PORT=8080
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=json
# Compose stack (make deps-up at the repo root). In AWS: the Aurora READER endpoint.
DATABASE_READER_URL=postgres://rusuh:<POSTGRES_PASSWORD>@127.0.0.1:15432/rusuh?sslmode=disable
REDIS_ADDR=localhost:16379
REDIS_CLUSTER=true
# Must equal the queue service's value: it decides when the home page says FULL_QUEUE.
QUEUE_CAPACITY=300000
EVENTS_CACHE_MAX_AGE_SECONDS=30
EVENTS_DEGRADED_MAX_AGE_SECONDS=5
# Cloudflare Turnstile site key (public). Required outside local.
TURNSTILE_SITE_KEY=
