APP_PORT=8082
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=json

# Required, no default. The HMAC pepper for NIK hashing. In a deployed
# environment this comes from Secrets Manager (KMS-managed) and is the SAME
# value for every service that hashes a NIK. It can never be rotated.
NIK_PEPPER=local-dev-pepper-not-for-any-deployed-environment

DATABASE_URL=postgres://rusuh:rusuh@localhost:5432/rusuh?sslmode=disable
DATABASE_MAX_CONNS=4
DATABASE_CONN_LIFETIME=30m

REDIS_ADDR=localhost:6379
REDIS_DB=0

# stub avoids any network call and is refused when APP_ENV=production.
# A NIK ending 0000 is rejected; one ending 9999 simulates an outage.
DUKCAPIL_MODE=stub
DUKCAPIL_BASE_URL=
DUKCAPIL_API_KEY=
DUKCAPIL_TIMEOUT_MS=3000
DUKCAPIL_RATE_LIMIT_RPS=40
DUKCAPIL_BURST_CAPACITY=80
DUKCAPIL_BREAKER_FAILURE_THRESHOLD=5
DUKCAPIL_BREAKER_OPEN_SECONDS=30
