APP_PORT=8085
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=json

# Required, no default. Keys the guest device binding:
# HMAC(DEVICE_PEPPER, X-Device-Id) must equal the device_hash on the grant
# (ADR-006 section 8.9). Without it every guest checkout fails the device
# check while the service still reports healthy.
#
# NOT the NIK pepper and NOT JWT_SECRET. Unlike the NIK pepper it MAY be
# rotated - but only between sales, never during one: rotation invalidates
# every live binding at once.
DEVICE_PEPPER=local-dev-device-pepper-not-for-any-deployed-environment

DATABASE_URL=postgres://rusuh:rusuh@localhost:5432/rusuh?sslmode=disable
DATABASE_MAX_CONNS=4
DATABASE_CONN_LIFETIME=30m

REDIS_ADDR=localhost:6379
REDIS_DB=0

# Sandbox by default. A deployment that forgets this should charge nobody
# rather than charge everybody.
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
# Required, no default. Signs charges AND verifies every notification
# signature: SHA512(order_id + status_code + gross_amount + ServerKey).
# Missing, the service rejects every valid callback and confirms no booking.
MIDTRANS_SERVER_KEY=
# Required separately from server key since Midtrans split them on 28 Oct 2026.
# Verifies the signature_key on notifications. Wrong value = every webhook
# rejected as forgery, no booking ever confirmed.
MIDTRANS_SIGNATURE_SECRET_KEY=
MIDTRANS_TIMEOUT_MS=10000
PAYMENT_BREAKER_FAILURE_THRESHOLD=5
PAYMENT_BREAKER_OPEN_SECONDS=30
# Comma-separated list of IPs/CIDRs allowed to call POST /payments/webhook.
# Defense-in-depth alongside signature verification. In local, empty is OK
# (disables check). Outside local, empty FAILS startup (fail closed).
# Get from https://docs.midtrans.com/docs/ip-address — sandbox and prod differ.
# Format: comma-separated CIDR blocks; a single host is written /32. Paste the
# ranges from the URL above - that page is the only authoritative source.
MIDTRANS_WEBHOOK_IP_ALLOWLIST=

# The payment window (BR-05). Sent to Midtrans as custom_expiry so the
# gateway's deadline and ours end on the same second - without it a VA
# defaults to 24 HOURS and stays payable after the seats are resold.
PAYMENT_TTL_SECONDS=600
# Below this remaining, a method switch is refused: handing out a new VA with
# 15 seconds on it only moves the failure somewhere more painful.
MIN_RETRY_REMAINING_SECONDS=60
# Each attempt mints a new VA or QR at Midtrans.
MAX_PAYMENT_ATTEMPTS=5
# How long settled:{uuid} answers queue re-entrancy after the queue
# credential is deleted, so a guest refreshing between settlement and the
# e-ticket email is not shown an expiry screen (contract section 3.3).
SETTLED_TOMBSTONE_SECONDS=3600
PAYMENT_ICON_BASE=https://cdn.rusuh.id/icons
# The public web FRONTEND origin, the same variable notification uses for
# emailed links. POST /payments/{id}/handoff answers payment_url =
# APP_BASE_URL + PAYMENT_WEB_PATH ({booking_id} filled in) + #code=<code>.
# Must be https outside local; the mobile app opens only
# https://rush-my-ticket.my.id/m/orders/...
APP_BASE_URL=http://localhost:3000
PAYMENT_WEB_PATH=/m/orders/{booking_id}/pay
# How long the operator kill switch (payment_method_switches, migration 0014)
# is cached in process. This is the delay between an operator inserting a row
# and customers seeing it, traded against a query on the hottest path in the
# service. Zero disables the cache, which is what a debugging session wants.
PAYMENT_SWITCH_CACHE_SECONDS=10
# Account-session signing secret, the same value user-service issues with and
# booking verifies with. ADR-006 section 8.17: a grant naming an account is
# only honoured alongside that account's Bearer token, so a leaked grant
# cannot be spent in someone else's name. No default, in any environment: a
# default signing key is a forged-session generator.
JWT_SECRET=local-dev-jwt-secret-not-for-any-deployed-environment
