APP_PORT=8084
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=json

# The FRONTEND base URL, not the API: the verify endpoint reads its token from
# a cookie (contract §1.3), so the app route sets the cookie then calls the API.
# Must be https outside local — these links carry single-use login tokens.
APP_BASE_URL=http://localhost:3000

# Mirrors entity.MagicTokenTTL in services/user; quoted in link emails.
MAGIC_TOKEN_TTL_MINUTES=15

REDIS_ADDR=localhost:6379
REDIS_DB=0

# Required. Must be a verified SES identity in the deployment region.
EMAIL_FROM_ADDRESS=no-reply@localhost
# Routes bounces and complaints to SNS. Without it a bouncing address is
# invisible and SES eventually throttles the account for poor reputation.
SES_CONFIGURATION_SET=
EMAIL_SEND_TIMEOUT_MS=10000
