APP_PORT=8080
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=json
# Compose stack (make deps-up at the repo root)
DATABASE_URL=postgres://rusuh:<POSTGRES_PASSWORD>@127.0.0.1:15432/rusuh?sslmode=disable
REDIS_ADDR=localhost:16379
REDIS_CLUSTER=true
# Must equal queue's DEVICE_PEPPER, or every guest gets DEVICE_MISMATCH. Required outside local.
DEVICE_PEPPER=
# Account-session signing secret, the same value user-service issues with.
# ADR-006 section 8.17: an account grant is only honoured alongside that
# account's Bearer token, so a mismatch here is a 401 for every logged-in
# caller and an empty value is a 503. Required outside local.
JWT_SECRET=local-dev-jwt-secret-not-for-any-deployed-environment
MAX_TICKETS_PER_TRANSACTION=3
# The longest a NIK lock may block a NIK if its booking never completes. Same value as queue's SALE_WINDOW_SECONDS.
SALE_WINDOW_SECONDS=21600
# nik-verify's Lambda, invoked by POST /bookings to check typed NIKs. Empty locally = an in-process fake that follows the
# Dukcapil stub (a NIK ending 0000 is rejected, 9999 simulates an outage). Required outside local.
NIK_VERIFY_FUNCTION_NAME=
NIK_VERIFY_TIMEOUT_MS=3000
# Signs e-ticket links; must equal notification and user-service. Empty locally = random key per start.
ETICKET_SIGNING_KEY=
# Verifies the access token of an account grant (ADR-006 §8.17). Must equal user-service's JWT_SECRET, which signs it.
# Empty locally = user-service's example value, so a token from the local login works. Required outside local.
JWT_SECRET=local-dev-jwt-secret-not-for-any-deployed-environment
