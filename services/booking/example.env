APP_PORT=8080
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=json
# Compose stack (make deps-up at the repo root)
DATABASE_URL=postgres://rusuh:<POSTGRES_PASSWORD>@127.0.0.1:15432/rusuh?sslmode=disable
REDIS_ADDR=localhost:16379
REDIS_CLUSTER=true
# Must equal queue's DEVICE_PEPPER, or every guest gets DEVICE_MISMATCH. Required outside local.
DEVICE_PEPPER=
# Account-session signing secret, the same value user-service issues with.
# ADR-006 section 8.17: an account grant is only honoured alongside that
# account's Bearer token, so a mismatch here is a 401 for every logged-in
# caller and an empty value is a 503. Required outside local.
JWT_SECRET=local-dev-jwt-secret-not-for-any-deployed-environment
MAX_TICKETS_PER_TRANSACTION=3
# Signs e-ticket links; must equal notification and user-service. Empty locally = random key per start.
ETICKET_SIGNING_KEY=
