APP_PORT=8081
APP_ENV=local
APP_BASE_URL=http://localhost:8081
LOG_LEVEL=info
LOG_FORMAT=json

DATABASE_URL=postgres://rusuh:rusuh@localhost:5432/rusuh?sslmode=disable
DATABASE_MAX_CONNS=4
DATABASE_CONN_LIFETIME=30m

REDIS_ADDR=localhost:6379
REDIS_DB=0

# This service never calls Dukcapil directly. nik-verify owns the rate limiter,
# the circuit breaker that pauses admission (BR-13a) and the 24-hour cache, and
# returns nik_hmac so the pepper never enters this process.
NIK_VERIFY_BASE_URL=http://localhost:8082
NIK_VERIFY_TIMEOUT_MS=5000

# Required, no default. Signs access tokens; shared with every service that
# verifies them. NOT the NIK pepper — this one can and should be rotated.
JWT_SECRET=local-dev-jwt-secret-not-for-any-deployed-environment
# How long a sale stays open, gate to close. This service never queues anyone;
# it needs the value only because the session TTL is derived from it. The queue
# owns it (ADR-005 §4) and the real number is still open — Bagian 17 #10.
SALE_WINDOW_SECONDS=21600
# Leave UNSET in normal operation: it defaults to SALE_WINDOW_SECONDS + 1140
# (= 22740s, 6h19m at the fallback above). The session starts at LOGIN, before
# the queue, so it has to cover the wait AND the 930s journey + 60s BR-22 pause
# grace + 150s margin. Contract v2.3 hardcoded 1080 here, which is the GRANT
# token's interval; at ratePerMin 318 the back of a 300k queue waits ~15.7h, so
# 1080 died in the waiting room and the saved-NIK list 401'd on the Detail
# Ticket page — pushing the customer onto the fail-closed Dukcapil path.
#
# Set it only to SHORTEN the revocation window deliberately (this is a stateless
# JWT, so its lifetime IS that window). Startup refuses a value below
# SALE_WINDOW_SECONDS + 990.
# ACCESS_TOKEN_TTL_SECONDS=
COOKIE_DOMAIN=
# Secure cookies default on everywhere except local, and cannot be disabled
# outside local.
SECURE_COOKIES=false

# Maximum number of saved friend-NIK entries per account (BR-12).
# Defaults to 5 when unset. Must be at least 1.
# MAX_SAVED_NIKS=5
