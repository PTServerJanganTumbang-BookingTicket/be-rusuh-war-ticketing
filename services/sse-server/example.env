APP_ENV=local
APP_PORT=8085
LOG_LEVEL=info
LOG_FORMAT=json
REDIS_ADDR=localhost:16379
REDIS_CLUSTER=true
# Comma-separated list of allowed origins for CORS. Add your frontend origin here.
# e.g. https://rush-my-ticket.my.id,http://localhost:3000
CORS_ALLOW_ORIGIN=http://localhost:3000
# SSE_KEEPALIVE_SECONDS=15
# SSE_STALE_AFTER_SECONDS=30
# SSE_DRAIN_DEADLINE_SECONDS=20
# SSE_IP_LIMIT_PER_SECOND=5
