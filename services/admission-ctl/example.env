# Local development (make deps-up). Never commit real secrets.
LOG_FORMAT=text
LOG_LEVEL=info
DATABASE_URL=postgres://rusuh:<POSTGRES_PASSWORD>@127.0.0.1:15432/rusuh?sslmode=disable
REDIS_ADDR=127.0.0.1:16379
REDIS_CLUSTER=true
# Sales and their stock categories are found in Redis (queue:{ev} hashes, stock:{ev}:<category> keys).
EVENT_REFRESH_SECONDS=30
MAX_CONCURRENT_SLOTS=10
TICK_INTERVAL_MS=500
BOOKING_TTL_SECONDS=300
GRANT_TOKEN_TTL_SECONDS=1080
HEARTBEAT_SECONDS=10
FULL_BOOKED_CLOSE_SECONDS=930
ETA_SEED_SLOT_MINUTES=5

# Stock reconciliation (docs/05-booking/04-stock-reconciliation.md): every STOCK_RECONCILE_SECONDS per open sale, Redis stock
# and NIK locks are compared with Aurora and repaired. 0 turns it off.
STOCK_RECONCILE_SECONDS=60
# a drift below this is left alone; a drift above STOCK_MAX_CORRECTION is alarmed, not corrected
STOCK_DRIFT_THRESHOLD=1
STOCK_MAX_CORRECTION=20
# TTL of a restored NIK lock; the same value booking uses
SALE_WINDOW_SECONDS=21600
