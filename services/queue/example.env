# Local development (make deps-up). Never commit real secrets.
APP_ENV=local
APP_PORT=8084
LOG_FORMAT=text
DATABASE_URL=postgres://rusuh:<POSTGRES_PASSWORD>@127.0.0.1:15432/rusuh?sslmode=disable
REDIS_ADDR=127.0.0.1:16379
REDIS_CLUSTER=true
# Must equal user-service's JWT_SECRET (it signs the tokens queue and booking verify).
JWT_SECRET=local-dev-jwt-secret-not-for-any-deployed-environment
DEVICE_PEPPER=local-only-device-pepper
SSE_BASE_URL=
QUEUE_CAPACITY=300000
SALE_WINDOW_SECONDS=21600
# turnstile (needs TURNSTILE_SECRET_KEY outside local) | mock (never in production)
CAPTCHA_PROVIDER=mock
TURNSTILE_SECRET_KEY=
