# Binaries
bin/
*.exe
*.test

# Coverage
*.out
*.cov
coverage/

# Env
.env

# go.work is COMMITTED (see README) so local + CI share one workspace definition.
# Its checksum file is machine-generated and need not be committed.
go.work.sum

# IDE / OS
.idea/
.vscode/
.DS_Store

# Sonar
.scannerwork/
sonar-*.json

# SAM
.aws-sam/

# Created by the deploy pipeline (.github/actions/sam-deploy) so that
# `sam build` can copy a self-contained service directory. Not committed:
# it is a build artifact, it duplicates pkg/, and a stale copy would shadow
# the real source.
services/*/vendor/
# Pinned tools built by the Makefile
.bin/
tools/speccheck/speccheck

# AI steering and Claude Code harness: local only, not part of the team repo
CLAUDE.md
.claude/
docs/DEVELOPMENT-FLOW.md
scripts/claude-hooks/
