{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/post-edit.sh",
            "timeout": 120,
            "statusMessage": "gofmt + build / make spec"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/stop-verify.sh",
            "timeout": 600,
            "statusMessage": "make verify-fast"
          }
        ]
      }
    ]
  }
}
